# ---------------------------------------------------------------
# Aspire Dashboard - Build from source (with Elasticsearch persistence)
# ---------------------------------------------------------------
# Official image downloads pre-built binaries. This Dockerfile builds
# from source to include custom changes (e.g., Elasticsearch log persistence).
#
# Build:
#   docker build -f Dockerfile.dashboard -t jessegador/aspire-dashboard:latest .
#
# Run:
#   # For local kubectl port-forward on the host machine, use host.docker.internal.
#   docker run -p 18888:18888 -p 18889:18889 -p 18890:18890 `
#     -e Dashboard__Elasticsearch__Enabled=true `
#     -e Dashboard__Elasticsearch__Endpoint=http://host.docker.internal:9200 `
#     jessegador/aspire-dashboard:latest
# ---------------------------------------------------------------

# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /repo

# Copy build infrastructure (Arcade SDK, versions, package management)
COPY global.json Directory.Build.props Directory.Build.targets Directory.Packages.props NuGet.config ./
COPY eng/ eng/

# Copy all source required for the Dashboard
COPY src/Aspire.Dashboard/ src/Aspire.Dashboard/
COPY src/Shared/ src/Shared/
COPY src/Aspire.Hosting/Dashboard/proto/ src/Aspire.Hosting/Dashboard/proto/

# Restore and publish
RUN dotnet publish src/Aspire.Dashboard/Aspire.Dashboard.csproj \
    -c Release \
    -f net8.0 \
    -o /app

# Stage 2: Runtime - matches official Aspire Dashboard base image
FROM mcr.microsoft.com/dotnet/aspnet:8.0-azurelinux3.0-distroless-extra

WORKDIR /app
COPY --from=build /app .

ENV \
    # Unset ASPNETCORE_HTTP_PORTS from base image
    ASPNETCORE_HTTP_PORTS= \
    # Dashboard frontend
    ASPNETCORE_URLS=http://+:18888 \
    # OTLP gRPC endpoint
    DOTNET_DASHBOARD_OTLP_ENDPOINT_URL=http://+:18889 \
    # OTLP HTTP endpoint
    DOTNET_DASHBOARD_OTLP_HTTP_ENDPOINT_URL=http://+:18890 \
    # MCP endpoint
    DOTNET_DASHBOARD_MCP_ENDPOINT_URL=http://+:18891

ENTRYPOINT ["dotnet", "/app/Aspire.Dashboard.dll"]
