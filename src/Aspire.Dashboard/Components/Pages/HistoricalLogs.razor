@page "/historicallogs"

@using Aspire.Dashboard.Otlp.Storage.Elasticsearch
@using Aspire.Dashboard.Utils
@using Microsoft.FluentUI.AspNetCore.Components

<PageTitle>Historical Logs - Aspire Dashboard</PageTitle>

<div class="page-content-container">
    <div style="padding: 16px;">
        <h1 class="page-header" style="margin-bottom: 16px;">Historical Logs</h1>

        <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: end; margin-bottom: 16px;">
            <div>
                <FluentTextField Label="Start Time"
                                 @bind-Value="_startTimeText"
                                 Placeholder="yyyy-MM-dd HH:mm"
                                 Style="width: 200px;" />
            </div>
            <div>
                <FluentTextField Label="End Time"
                                 @bind-Value="_endTimeText"
                                 Placeholder="yyyy-MM-dd HH:mm"
                                 Style="width: 200px;" />
            </div>
            <div>
                <FluentSelect Label="Service"
                              Items="@_serviceOptions"
                              @bind-SelectedOption="_selectedService"
                              OptionText="@(s => s)"
                              Style="min-width: 200px;" />
            </div>
            <div>
                <FluentSelect Label="Log Level"
                              Items="@_logLevelOptions"
                              @bind-SelectedOption="_selectedLogLevel"
                              OptionText="@(l => l)"
                              Style="min-width: 150px;" />
            </div>
            <div>
                <FluentSearch @bind-Value="_searchText"
                              Placeholder="Search messages..."
                              Style="width: 250px;" />
            </div>
            <div>
                <FluentButton Appearance="Appearance.Accent" OnClick="SearchAsync">Search</FluentButton>
            </div>
        </div>

        @if (_isLoading)
        {
            <FluentProgress />
        }
        else if (_result is not null)
        {
            <div style="margin-bottom: 8px; color: var(--neutral-foreground-hint);">
                Showing @(_result.Items.Count) of @_result.TotalCount total logs
                @if (_totalPages > 1)
                {
                    <span> &mdash; Page @(_currentPage + 1) of @_totalPages</span>
                }
            </div>

            <FluentDataGrid Items="@_result.Items.AsQueryable()"
                            TGridItem="HistoricalLogEntry"
                            Virtualize="true"
                            ItemSize="46"
                            GenerateHeader="GenerateHeaderOption.Sticky"
                            GridTemplateColumns="1fr 0.5fr 1fr 4fr"
                            Style="height: calc(100vh - 320px); overflow: auto;"
                            ShowHover="true">
                <PropertyColumn Property="@(e => e.ServiceName)" Title="Service" Sortable="true" />
                <TemplateColumn Title="Level">
                    <span class="@GetLogLevelClass(context.LogLevel)">@context.LogLevel</span>
                </TemplateColumn>
                <TemplateColumn Title="Timestamp" Sortable="true" SortBy="@_timestampSort">
                    @context.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")
                </TemplateColumn>
                <PropertyColumn Property="@(e => e.Message)" Title="Message" />
            </FluentDataGrid>

            @if (_totalPages > 1)
            {
                <div style="display: flex; gap: 8px; margin-top: 12px; align-items: center; justify-content: center;">
                    <FluentButton Appearance="Appearance.Stealth"
                                  Disabled="@(_currentPage == 0)"
                                  OnClick="PreviousPageAsync">
                        Previous
                    </FluentButton>
                    <span>Page @(_currentPage + 1) of @_totalPages</span>
                    <FluentButton Appearance="Appearance.Stealth"
                                  Disabled="@(_currentPage >= _totalPages - 1)"
                                  OnClick="NextPageAsync">
                        Next
                    </FluentButton>
                </div>
            }
        }
        else
        {
            <div style="text-align: center; padding: 48px; color: var(--neutral-foreground-hint);">
                <FluentIcon Value="@(new Icons.Regular.Size24.SlideTextSparkle())" />
                <p>Enter a time range and click Search to view historical logs from Elasticsearch.</p>
            </div>
        }
    </div>
</div>

<style>
    .log-level-trace { color: var(--neutral-foreground-hint); }
    .log-level-debug { color: var(--neutral-foreground-hint); }
    .log-level-information { color: var(--accent-foreground-rest); }
    .log-level-warning { color: var(--warning); font-weight: 600; }
    .log-level-error { color: var(--error); font-weight: 600; }
    .log-level-critical { color: var(--error); font-weight: 700; }
</style>
